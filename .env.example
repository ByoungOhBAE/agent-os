# AgentOS binds only to 127.0.0.1.
AGENTOS_PORT=4177
HERMES_DASHBOARD_URL=http://127.0.0.1:9119
# Optional: use the documented Hermes API Server for chat and run control.
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
# Named profiles require their own API_SERVER_KEY when multiplex routing is enabled.
# Example: {"writer":"profile-specific-key"}
HERMES_PROFILE_KEYS_JSON={}
# 학원 콘텐츠 생성기 연동: 홈페이지 주소(https만 허용, 로컬 테스트는 http://127.0.0.1:* 예외). 비우면 https://kmastercook.com
ACADEMY_CONTENT_URL=
# 홈페이지 AGENTOS_CONTENT_TOKEN과 같은 값. 비우면 콘텐츠 생성기는 "연결 안 됨"(503 not_configured).
ACADEMY_CONTENT_TOKEN=
